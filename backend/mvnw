#!/bin/sh
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DISTRIBUTION_URL=$(sed -n 's/^distributionUrl=//p' "$BASE_DIR/.mvn/wrapper/maven-wrapper.properties")
ARCHIVE_NAME=${DISTRIBUTION_URL##*/}
DISTRIBUTION_NAME=${ARCHIVE_NAME%-bin.zip}
WRAPPER_HOME="${HOME}/.m2/wrapper/dists/${DISTRIBUTION_NAME}"
MAVEN_HOME="${WRAPPER_HOME}/${DISTRIBUTION_NAME}"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
    mkdir -p "$WRAPPER_HOME"
    ARCHIVE_PATH="$WRAPPER_HOME/$ARCHIVE_NAME"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$DISTRIBUTION_URL" -o "$ARCHIVE_PATH"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$DISTRIBUTION_URL" -O "$ARCHIVE_PATH"
    else
        echo "Maven Wrapper requires curl or wget to download Maven." >&2
        exit 1
    fi
    unzip -q -o "$ARCHIVE_PATH" -d "$WRAPPER_HOME"
    rm -f "$ARCHIVE_PATH"
fi

cd "$BASE_DIR"
exec "$MAVEN_HOME/bin/mvn" "$@"
